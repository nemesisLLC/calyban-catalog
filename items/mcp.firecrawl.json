{
  "id": "mcp.firecrawl",
  "kind": "mcp",
  "name": "Firecrawl",
  "description": "Scrape, crawl and extract structured data from any website.",
  "author": "Firecrawl",
  "repo": "firecrawl/firecrawl-mcp-server",
  "homepage": "https://github.com/firecrawl/firecrawl-mcp-server",
  "icon": "https://github.com/firecrawl.png?size=128",
  "category": "Browser & Web",
  "tags": [
    "mcp",
    "local",
    "featured"
  ],
  "version": "3.40.0",
  "agents": [
    "claude",
    "codex"
  ],
  "runsCode": true,
  "install": {
    "type": "mcp-stdio",
    "name": "firecrawl",
    "command": "npx",
    "args": [
      "-y",
      "firecrawl-mcp@3.40.0"
    ],
    "env": {
      "FIRECRAWL_API_KEY": "{{FIRECRAWL_API_KEY}}"
    },
    "inputs": [
      {
        "name": "FIRECRAWL_API_KEY",
        "description": "Firecrawl API key",
        "secret": true,
        "required": true
      }
    ]
  }
}
