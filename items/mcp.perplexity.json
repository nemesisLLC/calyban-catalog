{
  "id": "mcp.perplexity",
  "kind": "mcp",
  "name": "Perplexity",
  "description": "Real-time web search and research answers from Perplexity.",
  "author": "Perplexity",
  "repo": "perplexityai/modelcontextprotocol",
  "homepage": "https://github.com/perplexityai/modelcontextprotocol",
  "icon": "https://github.com/perplexityai.png?size=128",
  "category": "Documentation & Research",
  "tags": [
    "mcp",
    "local",
    "featured"
  ],
  "version": "1.3.0",
  "agents": [
    "claude",
    "codex"
  ],
  "runsCode": true,
  "install": {
    "type": "mcp-stdio",
    "name": "perplexity",
    "command": "npx",
    "args": [
      "-y",
      "@perplexity-ai/mcp-server@1.3.0"
    ],
    "env": {
      "PERPLEXITY_API_KEY": "{{PERPLEXITY_API_KEY}}"
    },
    "inputs": [
      {
        "name": "PERPLEXITY_API_KEY",
        "description": "Perplexity API key",
        "secret": true,
        "required": true
      }
    ]
  }
}
